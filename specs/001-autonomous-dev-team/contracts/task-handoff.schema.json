{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-handoff.schema.json",
  "title": "TaskHandoff",
  "description": "One task the PM hands to the Coder: the JSON form of TeamState.handoff (a Task). See handoff-protocol.md.",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T[1-8]$",
      "description": "System-assigned, by position in the task list."
    },
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "acceptance_criteria": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "priority": {"type": "string", "enum": ["high", "medium", "low"]}
  },
  "required": ["task_id", "title", "description", "acceptance_criteria", "priority"],
  "additionalProperties": false
}
