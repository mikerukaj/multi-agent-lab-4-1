# Copy to .env and fill in. .env is never committed or copied into the image.

# Required: the Anthropic API key, supplied at run time only.
ANTHROPIC_API_KEY=

# Required by docker-compose.yml: run the agent as you, and let it use the Docker socket.
#   HOST_UID=$(id -u)   HOST_GID=$(id -g)   DOCKER_GID=$(stat -c %g /var/run/docker.sock)
HOST_UID=
HOST_GID=
DOCKER_GID=

# Optional: the requirement `docker compose up` runs (a temperature converter if unset).
TEAM_REQUIREMENT=

# Optional: LangSmith tracing (off unless both are set).
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
